# ---------------------------------------------------------------------------
# GumbInvest — environment configuration
# Copy to `.env` (`cp .env.example .env`) and adjust as needed.
# Every value below has a sane default; the stack boots with zero edits.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_USER=gumbinvest
POSTGRES_PASSWORD=gumbinvest
POSTGRES_DB=gumbinvest
# Host port for Postgres (5433 avoids clashing with a local Postgres on 5432)
POSTGRES_PORT=5433

# --- Published ports -------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Application -----------------------------------------------------------
APP_NAME=GumbInvest
# Base currency used for every monetary figure (B3 exports are BRL)
BASE_CURRENCY=BRL
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
# CORS origins for the API (comma separated). Not needed when using the
# bundled nginx frontend, which proxies /api on the same origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Run `alembic upgrade head` on backend start
RUN_MIGRATIONS=true

# --- Market data -----------------------------------------------------------
# Provider: yahoo | brapi | yfinance | none
# * yahoo     -> Yahoo Finance chart API, no key needed (recommended default)
# * brapi     -> brapi.dev, richest B3 data; requires a free token (see below)
# * yfinance  -> Yahoo Finance via the yfinance package (tickers suffixed .SA)
# * none      -> disables live quotes; the app falls back to average cost
MARKET_DATA_PROVIDER=yahoo
# Optional brapi token. Without it, brapi's free tier is heavily rate limited.
BRAPI_TOKEN=
BRAPI_BASE_URL=https://brapi.dev/api
# Seconds a quote is considered fresh before a refresh is attempted
QUOTE_CACHE_TTL=900
# Automatic price refresh interval, in minutes (Celery beat)
PRICE_REFRESH_MINUTES=30
# Daily snapshot job (server local time, cron-ish HH:MM)
SNAPSHOT_TIME=23:10
# Automatic database backup (pg_dump) — daily at this time; empty disables
BACKUP_TIME=03:30
BACKUP_DIR=/backups
BACKUP_KEEP=14

# --- Importer --------------------------------------------------------------
# Directory scanned on boot for an initial auto-import (optional). Searched
# recursively for the B3 CSV *and* for broker statement PDFs, so
# ./data/avenue/**.pdf and ./data/nomad/**.pdf are picked up as well.
# Re-importing is a no-op, so leaving this on is safe.
AUTO_IMPORT_DIR=/data
AUTO_IMPORT_ON_STARTUP=true

# AI assistant (chat on the asset page). Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# SEC EDGAR (Carteiras publicas) exige um User-Agent com contato; troque pelo seu e-mail.
SEC_USER_AGENT=GumbInvest/1.0 (self-hosted; contact: seu-email@exemplo.com)
