#!/bin/sh
# The same refusal, one step later.
#
# commit-msg only fires where it is installed: a clone that never ran the
# `core.hooksPath` line below, a session with --no-verify, a commit made by
# some other tool. This is the net under that — it reads the commits actually
# about to leave the machine, which is the last honest moment to catch one.
#
# Scope is `--not --remotes`: only commits no remote has yet. Anything already
# published is history, and blocking a push over it would be theatre — see the
# note in CLAUDE.md about the one commit that predates these hooks.

pattern='^[[:space:]]*[Cc]o-[Aa]uthored-[Bb]y:|noreply@anthropic\.com|[Gg]enerated with \[[Cc]laude [Cc]ode\]'
failed=0

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # All-zero local sha means a branch is being deleted; nothing to read.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac

  for sha in $(git rev-list "$local_sha" --not --remotes 2>/dev/null); do
    if git log -1 --format=%B "$sha" | git stripspace --strip-comments | grep -qE "$pattern"; then
      printf '  %s  %s\n' "$(git rev-parse --short "$sha")" "$(git log -1 --format=%s "$sha")" >&2
      failed=1
    fi
  done
done

if [ "$failed" -eq 1 ]; then
  printf '\n  Push refused: the commits above carry AI attribution.\n' >&2
  printf '  Commits here are authored by Gustavo alone (CLAUDE.md).\n' >&2
  printf '  Rewrite them (git rebase -i / git commit --amend) and push again.\n\n' >&2
  exit 1
fi

exit 0
