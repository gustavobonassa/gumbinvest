{
  "name": "gumbinvest-desktop",
  "version": "1.4.3",
  "description": "GumbInvest — gerenciador de carteira de investimentos",
  "author": "Gustavo Bonassa",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron . --dev",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "dev.gumbinvest.app",
    "productName": "GumbInvest",
    "afterPack": "scripts/afterPack.js",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "error.html",
      "qr.html",
      "assets/**",
      "node_modules/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "gustavobonassa",
        "repo": "gumbinvest"
      }
    ],
    "extraResources": [
      {
        "from": "../packaging/dist/gumbinvest-server",
        "to": "server"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
